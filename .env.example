# ── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://fbbc-matthews.vercel.app

# ── VSL video (Page 1) ──────────────────────────────────────────────────
# provider: "mp4" | "youtube" | "vimeo"
NEXT_PUBLIC_VSL_PROVIDER=mp4
# mp4: full URL to the video file · youtube/vimeo: the video ID only
NEXT_PUBLIC_VSL_ID=
NEXT_PUBLIC_VSL_POSTER=/images/vsl-poster.jpg

# ── GoHighLevel ─────────────────────────────────────────────────────────
# Inbound webhook URL (server-side only — never exposed to the browser)
GHL_WEBHOOK_URL=
# "Transformation Call" calendar permalink (the widget URL, not the iframe snippet)
NEXT_PUBLIC_GHL_CALENDAR_URL=

# ── Tracking ────────────────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
# PostHog (heatmaps, replays, funnel + A/B readout). Public phc_ key.
# Can also be hardcoded in components/Analytics.tsx (POSTHOG_KEY constant).
NEXT_PUBLIC_POSTHOG_KEY=
# US cloud default; set https://eu.i.posthog.com for EU projects.
NEXT_PUBLIC_POSTHOG_HOST=

# ── A/B test overrides (blank = 50/50 cookie split via middleware) ──────
# Set to "a" or "b" to force a variant for everyone.
NEXT_PUBLIC_AB_HEADLINE=
NEXT_PUBLIC_AB_Q1=
NEXT_PUBLIC_AB_SKIP_PLAN=
